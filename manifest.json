{
    "manifest_version": 3,
    "name": "微信公众号HTML编辑器",
    "version": "5.2.3",
    "key": "",
    "description": "全网页剪存到 WPS 知识库，并保留图片、代码块；同时提供微信公众号 HTML 编辑工作台。",
    "icons": {
        "48": "icon.png",
        "128": "icon.png"
    },
    "permissions": ["clipboardRead", "clipboardWrite", "storage", "contextMenus", "commands", "nativeMessaging"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "打开云中书插件设置"
    },
    "options_page": "settings.html",
    "chrome_url_overrides": {
        "newtab": "sinan.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "exclude_matches": [
                "https://mp.weixin.qq.com/cgi-bin/appmsg*",
                "https://mp.weixin.qq.com/appmsg/*"
            ],
            "js": ["web-content.js"],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://mp.weixin.qq.com/cgi-bin/appmsg*",
                "https://mp.weixin.qq.com/appmsg/*"
            ],
            "js": ["engine.js", "content.js"],
            "run_at": "document_end"
        }
    ],
    "commands": {
        "webClip": {
            "suggested_key": {"default": "Alt+Shift+S"},
            "description": "剪存当前网页到 WPS 知识库"
        },
        "webSummary": {
            "suggested_key": {"default": "Alt+Shift+I"},
            "description": "总结当前网页"
        }
    }
}
