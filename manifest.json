{
    "manifest_version": 3,
    "name": "云中书 AI 稿件库与导出工作台",
    "version": "6.0.0",
    "minimum_chrome_version": "116",
    "key": "",
    "description": "本地 AI 稿件库、版本与内容包备份，主动导出到微信公众号编辑器；保留 WPS 网页剪存和司南首页。",
    "icons": {
        "48": "icon.png",
        "128": "icon.png"
    },
    "permissions": ["clipboardRead", "clipboardWrite", "storage", "contextMenus", "commands", "nativeMessaging", "offscreen", "unlimitedStorage", "alarms"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "打开云中书插件菜单",
        "default_popup": "popup.html"
    },
    "options_page": "settings.html",
    "chrome_url_overrides": {
        "newtab": "sinan.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "exclude_matches": [
                "https://mp.weixin.qq.com/cgi-bin/appmsg*",
                "https://mp.weixin.qq.com/appmsg/*"
            ],
            "js": ["web-content.js"],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://mp.weixin.qq.com/cgi-bin/appmsg*",
                "https://mp.weixin.qq.com/appmsg/*"
            ],
            "js": ["engine.js", "draft-sanitize.js", "platform-adapters/wechat.js", "content.js"],
            "run_at": "document_end"
        }
    ],
    "commands": {
        "webClip": {
            "suggested_key": {"default": "Alt+Shift+S"},
            "description": "剪存当前网页到 WPS 知识库"
        },
        "webSummary": {
            "suggested_key": {"default": "Alt+Shift+I"},
            "description": "总结当前网页"
        }
    }
}
